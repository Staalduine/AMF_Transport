  shorttitle = {Trading on the Arbuscular Mycorrhiza Market},
  author = {Wipf, Daniel and Krajinski, Franziska and family=Tuinen, given=Diederik, prefix=van, useprefix=true and Recorbet, Ghislaine and Courty, Pierre-Emmanuel},
