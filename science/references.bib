}

@article{worrichMyceliummediatedTransferWater2017,
  title = {Mycelium-Mediated Transfer of Water and Nutrients Stimulates Bacterial Activity in Dry and Oligotrophic Environments},
  author = {Worrich, Anja and Stryhanyuk, Hryhoriy and Musat, Niculina and König, Sara and Banitz, Thomas and Centler, Florian and Frank, Karin and Thullner, Martin and Harms, Hauke and Richnow, Hans-Hermann and Miltner, Anja and Kästner, Matthias and Wick, Lukas Y.},
  date = {2017-06-07},
