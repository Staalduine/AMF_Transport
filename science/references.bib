@article{schroder3DLagrangianParticle2023,
  title = {{{3D Lagrangian Particle Tracking}} in {{Fluid Mechanics}}},
  author = {Schröder, Andreas and Schanz, Daniel},
  date = {2023-01-19},
  journaltitle = {Annual Review of Fluid Mechanics},
  volume = {55},
  pages = {511--540},
  publisher = {Annual Reviews},
  issn = {0066-4189, 1545-4479},
  doi = {10.1146/annurev-fluid-031822-041721},
  url = {https://www.annualreviews.org/content/journals/10.1146/annurev-fluid-031822-041721},
  urldate = {2025-04-28},
  abstract = {In the past few decades various particle image–based volumetric flow measurement techniques have been developed that have demonstrated their potential in accessing unsteady flow properties quantitatively in various experimental applications in fluid mechanics. In this review, we focus on physical properties and circumstances of 3D particle–based measurements and what knowledge can be used for advancing reconstruction accuracy and spatial and temporal resolution, as well as completeness. The natural candidate for our focus is 3D Lagrangian particle tracking (LPT), which allows for position, velocity, and acceleration to be determined alongside a large number of individual particle tracks in the investigated volume. The advent of the dense 3D LPT technique Shake-The-Box in the past decade has opened further possibilities for characterizing unsteady flows by delivering input data for powerful data assimilation techniques that use Navier–Stokes constraints. As a result, high-resolution Lagrangian and Eulerian data can be obtained, including long particle trajectories embedded in time-resolved 3D velocity and pressure fields.},
  issue = {Volume 55, 2023},
  langid = {english},
  file = {/Users/simonvanstaalduine/Zotero/storage/GHQXESVU/Schröder and Schanz - 2023 - 3D Lagrangian Particle Tracking in Fluid Mechanics.pdf;/Users/simonvanstaalduine/Zotero/storage/32DV65VL/annurev-fluid-031822-041721.html}
}

