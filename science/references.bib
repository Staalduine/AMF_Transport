  abstract = {The conservation of architectural heritage is a big challenge in times with increasing air pollution with aggressive gases. A second major threat to buildings is the combination of water and air contaminants which may be used by microorganisms for their metabolism. Hence, myriads of different bacteria and fungi populate stone surfaces and penetrate into the fine pores and cracks. Whereas epoxid-based paintings (or other paintings) may protect the coated surfaces from water and aggressive gases, these chemicals seal the stone surface and prevent also the evaporation of vapor from the inside of the buildings. Here, we tested a natural, fungal protein-based coating method. Fungi use small, amphiphilic proteins to turn their surfaces hydrophobic. We found that Aspergillus nidulans hydrophobin DewA and Trichoderma reesei HFBI confer hydrophobicity to stones but keep their pores open. The effect resembles “Gore-tex” fabric\&nbsp;material.},
  langid = {english},
  keywords = {Biomaterials,Fungi},
  file = {/Users/simonvanstaalduine/Zotero/storage/FGKS6TMC/Winandy et al. - 2019 - Fungal hydrophobins render stones impermeable for water but keep them permeable for vapor.pdf}
}

@article{wipfTradingArbuscularMycorrhiza2019,
