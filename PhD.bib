	shorttitle = {Parasexual and {Sexual} {Reproduction} in {Arbuscular} {Mycorrhizal} {Fungi}},
	url = {https://www.sciencedirect.com/science/article/pii/S0966842X20300846},
	doi = {10.1016/j.tim.2020.03.013},
	abstract = {Arbuscular mycorrhizal fungi (AMF) harbor thousands of nuclei in a large syncytium at all times. Although mating processes have not been observed in AMF, their cells and genomes show many signatures of sexual reproduction. Here, we describe how some of these signatures could also arise from parasexual processes in these widespread plant symbionts. As such, parasexual and sexual evolution could both be at play in generating nuclear diversity in AMF.},
