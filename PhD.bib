	year = {1995},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1111/j.1469-8137.1995.tb05726.x},
	keywords = {Glomus sp., mycorrhizal benefit, pasture species, root hair length},
	pages = {247--254},
	file = {Full Text PDF:C\:\\Users\\coren\\Zotero\\storage\\8G6AAQCX\\Schweiger et al. - 1995 - Root hair length determines beneficial effect of a.pdf:application/pdf;Snapshot:C\:\\Users\\coren\\Zotero\\storage\\W4LRQHIP\\j.1469-8137.1995.tb05726.html:text/html},
