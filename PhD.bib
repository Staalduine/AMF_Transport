	keywords = {Arbuscular mycorrhiza, Plant molecular biology},
	pages = {5743},
	file = {Full Text PDF:C\:\\Users\\coren\\Zotero\\storage\\R85QNC9A\\Zhang et al. - 2023 - Control of arbuscule development by a transcriptio.pdf:application/pdf},
