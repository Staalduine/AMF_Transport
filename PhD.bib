	note = {Publisher: Taylor \& Francis
\_eprint: https://doi.org/10.5941/MYCO.2015.43.4.444},
	keywords = {Rhizophagus clarus, Arbuscular mycorrhzal fungi, Genetic variability, In vitro culture, Intraspecific diversity},
