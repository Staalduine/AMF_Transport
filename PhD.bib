	year = {2002},
	note = {\_eprint: https://nph.onlinelibrary.wiley.com/doi/pdf/10.1046/j.0028-646X.2001.00316.x},
	keywords = {arbuscular mycorrhiza, respiration, 13C, carbon cycling, carbon flow, liming, mesh cores, stable isotope},
	pages = {327--334},
	file = {Full Text PDF:C\:\\Users\\coren\\Zotero\\storage\\J38KHHQL\\Johnson et al. - 2002 - In situ13CO2 pulse-labelling of upland grassland d.pdf:application/pdf;Snapshot:C\:\\Users\\coren\\Zotero\\storage\\SD8L5CZE\\j.0028-646X.2001.00316.html:text/html},
