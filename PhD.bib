	volume = {81},
	issn = {1350-0872,},
	url = {https://www.microbiologyresearch.org/content/journal/micro/10.1099/00221287-81-1-225},
	doi = {10.1099/00221287-81-1-225},
	abstract = {Growth of {\textless}span class="jp-italic"{\textgreater}Mucor hiemalis, Geotrichum candidum, Aspergillus nidulans, Neurospora crassa{\textless}/span{\textgreater} and {\textless}span class="jp-italic"{\textgreater}Penicillium chrysogenum{\textless}/span{\textgreater} was studied by time lapse photography. The total hyphal length of the mycelium of each species increased at an exponential rate; in {\textless}span class="jp-italic"{\textgreater}M. hiemalis{\textless}/span{\textgreater} exponential growth continued until the mycelium had a total hyphal length in excess of 10 mm. After spore germination there was an initial phase of discontinuous tip production followed by a phase of ‘continuous’ tip production. The hyphal length and number of tips possessed by a mycelium increased exponentially at approximately the same specific growth rate. The amplitude of the oscillations in the length of the hyphal growth unit of a mycelium decreased progressively during mycelial growth and eventually the growth unit attained a more or less constant value. The results support the hypothesis that mycelial growth involves the duplication of a ‘growth unit’ which consists of a tip and a certain mean length of hypha.,},
	number = {1},
	urldate = {2020-12-07},
	journal = {Microbiology,},
	author = {Trinci, A. P. J.},
