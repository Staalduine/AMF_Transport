@article{bucking_role_2015,
	title = {Role of {Arbuscular} {Mycorrhizal} {Fungi} in the {Nitrogen} {Uptake} of {Plants}: {Current} {Knowledge} and {Research} {Gaps}},
	volume = {5},
	issn = {2073-4395},
