@article{jakobs_kymobutler_2019,
	title = {{KymoButler}, a deep learning software for automated kymograph analysis},
	volume = {8},
	issn = {2050-084X},
	url = {https://doi.org/10.7554/eLife.42288},
	doi = {10.7554/eLife.42288},
	abstract = {Kymographs are graphical representations of spatial position over time, which are often used in biology to visualise the motion of fluorescent particles, molecules, vesicles, or organelles moving along a predictable path. Although in kymographs tracks of individual particles are qualitatively easily distinguished, their automated quantitative analysis is much more challenging. Kymographs often exhibit low signal-to-noise-ratios (SNRs), and available tools that automate their analysis usually require manual supervision. Here we developed KymoButler, a Deep Learning-based software to automatically track dynamic processes in kymographs. We demonstrate that KymoButler performs as well as expert manual data analysis on kymographs with complex particle trajectories from a variety of different biological systems. The software was packaged in a web-based ‘one-click’ application for use by the wider scientific community (http://kymobutler.deepmirror.ai). Our approach significantly speeds up data analysis, avoids unconscious bias, and represents another step towards the widespread adaptation of Machine Learning techniques in biological data analysis.},
	urldate = {2021-06-09},
	journal = {eLife},
	author = {Jakobs, Maximilian AH and Dimitracopoulos, Andrea and Franze, Kristian},
	editor = {Bassereau, Patricia and Malhotra, Vivek and Urbach, Jeff and Danuser, Gaudenz},
	month = aug,
	year = {2019},
	note = {Publisher: eLife Sciences Publications, Ltd},
	keywords = {artificial intelligence, kymograms, kymographs, machine learning, neurons, transport},
	pages = {e42288},
	file = {Full Text PDF:C\:\\Users\\coren\\Zotero\\storage\\NYC3JVVI\\Jakobs et al. - 2019 - KymoButler, a deep learning software for automated.pdf:application/pdf},
}

