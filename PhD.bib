}

@article{balestrini_photosynthetic_2020,
	title = {Photosynthetic {Traits} and {Nitrogen} {Uptake} in {Crops}: {Which} {Is} the {Role} of {Arbuscular} {Mycorrhizal} {Fungi}?},
