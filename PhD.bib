@incollection{fricker_adaptive_2009-1,
	title = {Adaptive {Biological} {Networks}},
	volume = {2009},
	isbn = {978-3-642-01283-9},
	abstract = {Mycelial fungi and acellular slime molds grow as self-organized networks that explore new territory to search for resources, whilst maintaining an effective internal transport system in the face of continuous attack or random damage. These networks adapt during development by selective reinforcement of major transport routes and recycling of the intervening redundant material to support further extension. In the case of fungi, the predicted transport efficiency of the weighted network is better than evenly weighted networks with the same topology, or standard reference networks. Experimentally, nutrient movement can be mapped using radio-tracers and scintillation imaging, and shows more complex transport dynamics, with synchronized oscillations and switching between different pre-existing routes. The significance of such dynamics to the interplay between transport control and topology is not yet known. In a similar manner, the resilience of the network can be tested in silico and experimentally using grazing invertebrates. Both approaches suggest that the same structures that confer good transport efficiency also show good resilience, with the persistence of a centrally connected core. The acellular slime mold, Physarum polycephalum also forms efficient networks between food sources, with a good balance between total cost, transit distance and fault tolerance. In this case, network formation can be captured by a mathematical model driven by non-linear positive reinforcement of tubes with high flux, and decay of tubes with low flux. We argue that organization of these simple planar networks has been honed by evolution, and they may exemplify potential solutions to real-world compromises between search strategy, transport efficiency, resilience and cost in other domains.},
	booktitle = {Understanding {Complex} {Systems}},
	author = {Fricker, Mark and Boddy, Lynne and Nakagaki, Toshiyuki and Bebber, Daniel},
	month = aug,
	year = {2009},
	doi = {10.1007/978-3-642-01284-6_4},
	pages = {51--70},
	annote = {Journal Abbreviation: Understanding Complex Systems},
}

