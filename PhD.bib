@article{fricker_mycelium_2017,
	title = {The {Mycelium} as a {Network}},
	volume = {5},
	issn = {2165-0497},
	url = {https://journals.asm.org/doi/10.1128/microbiolspec.FUNK-0033-2017},
	doi = {10.1128/microbiolspec.FUNK-0033-2017},
	abstract = {ABSTRACT The characteristic growth pattern of fungal mycelia as an interconnected network has a major impact on how cellular events operating on a micron scale affect colony behavior at an ecological scale. Network structure is intimately linked to flows of resources across the network that in turn modify the network architecture itself. This complex interplay shapes the incredibly plastic behavior of fungi and allows them to cope with patchy, ephemeral resources, competition, damage, and predation in a manner completely different from multicellular plants or animals. Here, we try to link network structure with impact on resource movement at different scales of organization to understand the benefits and challenges of organisms that grow as connected networks. This inevitably involves an interdisciplinary approach whereby mathematical modeling helps to provide a bridge between information gleaned by traditional cell and molecular techniques or biophysical approaches at a hyphal level, with observations of colony dynamics and behavior at an ecological level.},
	language = {en},
	number = {3},
	urldate = {2023-02-10},
	journal = {Microbiology Spectrum},
	author = {Fricker, Mark D. and Heaton, Luke L. M. and Jones, Nick S. and Boddy, Lynne},
	editor = {Heitman, Joseph and Gow, Neil A. R.},
	month = may,
	year = {2017},
	pages = {5.3.03},
}

